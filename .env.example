# Server Settings
NODE_ENV=production
PORT=5000
IP_ADDRESS=0.0.0.0
PROJECT_NAME="Fixpair"
BRAND_LOGO="https://yourdomain.com/logo.png"

# Database
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/fixpair?retryWrites=true&w=majority

# Security / Hashing
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=super_secret_jwt_key_here
JWT_EXPIRE_IN=30d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_here
JWT_REFRESH_EXPIRE_IN=365d

# Super Admin Initial Credentials
SUPER_ADMIN_EMAIL=admin@fixpair.com
SUPER_ADMIN_PASSWORD=ChangeMeStrongPassword123!

# Email Service (SMTP)
EMAIL_FROM=no-reply@fixpair.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Agora Video / Audio Live Consultancy
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_TOKEN_EXPIRATION_TIME=3600

# Stripe Payment
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# PayPal Payment
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Billing Defaults
PLATFORM_FIXED_FEE=5
MINIMUM_CONSULTATION_MINUTES=1
PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_RETRY_DELAY_SECONDS=30
CONSULTATION_WARNING_MINUTES=5
BILLING_INTERVAL_MS=60000

# Socket Configuration
SOCKET_DISCONNECT_GRACE_PERIOD_MS=60000

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Cloud Messaging (FCM)
FCM_SERVICE_ACCOUNT_BASE64=

# Apple Push Notification Service (APNS)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_VOIP_TOPIC=
APNS_P8_FILE_PATH=
APNS_PRODUCTION=false
